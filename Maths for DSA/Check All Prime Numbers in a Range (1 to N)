#include <iostream>
using namespace std;

int main() {
    int N = 50;
    for (int n = 2; n <= N; n++) {
        bool isPrime = true;
        for (int i = 2; i * i <= n; i++) {
            if (n % i == 0) {
                isPrime = false;
                break;
            }
        }
        if (isPrime) {
            cout << n << " ";
        }
    }
    return 0;
}
