#include <iostream>
#include <set>

using namespace std;

int main() {
    set<int> s;

    s.insert(5);
    s.insert(1);
    s.insert(3);
    s.insert(1); // Duplicate, will be ignored

    cout << "Set elements (Sorted & Unique): ";
    for(int val : s) {
        cout << val << " "; // Output will be: 1 3 5
    }
    cout << "\n";

    // Checking if an element exists
    if(s.find(3) != s.end()) {
        cout << "Element 3 is present in the set.\n";
    }

    return 0;
}
