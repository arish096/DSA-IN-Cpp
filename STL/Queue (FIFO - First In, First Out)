#include <iostream>
#include <queue>

using namespace std;

int main() {
    queue<int> q;

    q.push(10);
    q.push(20);
    q.push(30);

    cout << "Front element: " << q.front() << "\n"; // Outputs 10
    cout << "Back element: " << q.back() << "\n";   // Outputs 30

    q.pop(); // Removes front element (10)
    cout << "New front after pop: " << q.front() << "\n"; // Outputs 20

    return 0;
}
