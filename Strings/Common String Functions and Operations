#include <iostream>
#include <string>
#include <algorithm>

using namespace std;

int main() {
    string s1 = "hello";
    string s2 = "world";

    // 1. Concatenation
    string s3 = s1 + " " + s2;
    cout << "Concatenated: " << s3 << "\n";

    // 2. Substring (startIndex, length)
    string sub = s3.substr(0, 5);
    cout << "Substring (0 to 5): " << sub << "\n";

    // 3. Find substring position
    size_t pos = s3.find("world");
    cout << "'world' found at index: " << pos << "\n";

    // 4. Reverse a string (using algorithm header)
    reverse(s1.begin(), s1.end());
    cout << "Reversed s1: " << s1 << "\n";

    return 0;
}
