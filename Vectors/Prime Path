#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

const int MAXN = 100005;

bool is_prime[MAXN];
vector<int> adj[MAXN];
int component_id[MAXN];
long long comp_size[MAXN];

void sieve(int n) {
    fill(is_prime, is_prime + n + 1, true);
    is_prime[0] = is_prime[1] = false;
    for (int p = 2; p * p <= n; p++) {
        if (is_prime[p]) {
            for (int i = p * p; i <= n; i += p)
                is_prime[i] = false;
        }
    }
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    sieve(n);

    for (int i = 0; i < n - 1; ++i) {
        int u, v;
        cin >> u >> v;
        adj[u].push_back(v);
        adj[v].push_back(u);
    }

    // Group all connected non-prime nodes into components
    int cid = 0;
    for (int i = 1; i <= n; ++i) {
        if (!is_prime[i] && component_id[i] == 0) {
            cid++;
            vector<int> q = {i};
            component_id[i] = cid;
            int head = 0;
            while (head < (int)q.size()) {
                int curr = q[head++];
                for (int nxt : adj[curr]) {
                    if (!is_prime[nxt] && component_id[nxt] == 0) {
                        component_id[nxt] = cid;
                        q.push_back(nxt);
                    }
                }
            }
            comp_size[cid] = q.size();
        }
    }

    long long ans = 0;

    // For each prime node, count paths passing through it or starting at it
    for (int i = 1; i <= n; ++i) {
        if (is_prime[i]) {
            long long sum_sizes = 0;
            for (int neighbor : adj[i]) {
                if (!is_prime[neighbor]) {
                    long long sz = comp_size[component_id[neighbor]];
                    // 1. Paths between two different non-prime branches through prime i
                    ans += sum_sizes * sz;
                    // 2. Paths starting at prime i and ending in this non-prime branch
                    ans += sz;
                    sum_sizes += sz;
                }
            }
        }
    }

    cout << ans << "\n";

    return 0;
}
