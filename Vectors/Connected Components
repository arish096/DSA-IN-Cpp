#include <iostream>
#include <vector>

using namespace std;

const int MOD = 1e9 + 7;
const int MAXN = 200005;

long long fact[MAXN], invFact[MAXN];

// Fast exponentiation to compute (base^exp) % MOD
long long power(long long base, long long exp) {
    long long res = 1;
    base %= MOD;
    while (exp > 0) {
        if (exp % 2 == 1) res = (res * base) % MOD;
        base = (base * base) % MOD;
        exp /= 2;
    }
    return res;
}

// Modular inverse using Fermat's Little Theorem
long long modInverse(long long n) {
    return power(n, MOD - 2);
}

// Precompute factorials and inverse factorials for O(1) combinations
void precompute() {
    fact[0] = 1;
    invFact[0] = 1;
    for (int i = 1; i < MAXN; i++) {
        fact[i] = (fact[i - 1] * i) % MOD;
    }
    invFact[MAXN - 1] = modInverse(fact[MAXN - 1]);
    for (int i = MAXN - 2; i >= 1; i--) {
        invFact[i] = (invFact[i + 1] * (i + 1)) % MOD;
    }
}

// Combination nCr % MOD
long long nCr(int n, int r) {
    if (r < 0 || r > n) return 0;
    return fact[n] * invFact[r] % MOD * invFact[n - r] % MOD;
}

void solve() {
    long long N, M, C;
    cin >> N >> M >> C;

    // Special edge cases when C = 0
    if (C == 0) {
        if (N == M) cout << 1 << "\n";
        else cout << 0 << "\n";
        return;
    }

    long long R = N - M;

    if (C > R || C > M + 1) {
        cout << 0 << "\n";
        return;
    }

    long long way1 = nCr(R - 1, C - 1);
    long long way2 = nCr(M + 1, C);

    long long ans = (way1 * way2) % MOD;
    cout << ans << "\n";
}

int main() {
    // Fast I/O operations
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    precompute();

    int T;
    if (cin >> T) {
        while (T--) {
            solve();
        }
    }

    return 0;
}
