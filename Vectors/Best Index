#include <iostream>
#include <vector>
#include <cmath>
#include <algorithm>
#include <climits>

using namespace std;

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int n;
    if (!(cin >> n)) return 0;

    vector<long long> a(n);
    vector<long long> pref(n + 1, 0);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
        pref[i + 1] = pref[i] + a[i];
    }

    long long max_special_sum = LLONG_MIN;

    for (int i = 0; i < n; ++i) {
        long long rem = n - i;
        
        // Solve k*(k+1)/2 <= rem using quadratic formula
        long long k = (-1.0 + sqrt(1 + 8.0 * rem)) / 2.0;
        
        // Total elements taken in valid steps
        long long num_elements = k * (k + 1) / 2;
        
        // Sum from index i to i + num_elements - 1
        long long current_sum = pref[i + num_elements] - pref[i];
        
        max_special_sum = max(max_special_sum, current_sum);
    }

    cout << max_special_sum << "\n";

    return 0;
}
