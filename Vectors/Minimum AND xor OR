#include <iostream>
#include <vector>
#include <algorithm>
#include <climits>

using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<long long> a(n);
    for (int i = 0; i < n; ++i) {
        cin >> a[i];
    }

    // Sort the array to find the minimum XOR of adjacent elements
    sort(a.begin(), a.end());

    long long min_xor = LLONG_MAX;
    for (int i = 0; i < n - 1; ++i) {
        long long current_xor = a[i] ^ a[i + 1];
        min_xor = min(min_xor, current_xor);
    }

    cout << min_xor << "\n";
}

int main() {
    // Fast I/O
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);

    int t;
    cin >> t;
    while (t--) {
        solve();
    }

    return 0;
}
