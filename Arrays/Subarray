#include <bits/stdc++.h>
using namespace std;

void solve() {
    int n;
    cin >> n;

    vector<int> a(n);
    int ones = 0;

    for (int i = 0; i < n; i++) {
        cin >> a[i];
        ones += a[i];
    }

    // Already all ones
    if (ones == n) {
        cout << 0 << '\n';
        return;
    }

    // Not enough zeroes to separate all ones
    if (ones > (n + 1) / 2) {
        cout << -1 << '\n';
        return;
    }

    // Find maximum number of existing ones
    // that can be kept without adjacent ones.
    int keep = 0;
    int i = 0;

    while (i < n) {
        if (a[i] == 1) {
            int len = 0;

            while (i < n && a[i] == 1) {
                len++;
                i++;
            }

            keep += (len + 1) / 2;
        } else {
            i++;
        }
    }

    cout << ones - keep << '\n';
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(nullptr);

    int T;
    cin >> T;

    while (T--) {
        solve();
    }

    return 0;
}
