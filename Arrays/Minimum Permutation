#include <iostream>
#include <vector>
#include <algorithm>

using namespace std;

void solve() {
    int n;
    cin >> n;
    vector<int> a(n);
    for (int i = 0; i < n; i++) {
        cin >> a[i];
    }

    // 1. A prefix minimum array must be non-increasing
    for (int i = 1; i < n; i++) {
        if (a[i] > a[i - 1]) {
            cout << 0 << "\n";
            return;
        }
    }

    const int MOD = 1e9 + 7;
    vector<bool> used(n + 1, false);
    
    // Mark elements that MUST be fixed because they change the prefix minimum
    used[a[0]] = true;
    for (int i = 1; i < n; i++) {
        if (a[i] < a[i - 1]) {
            used[a[i]] = true;
        }
    }

    // Track available numbers greater than current A[i]
    // We can iterate backwards to easily count available numbers > A[i]
    long long ans = 1;
    int available_count = 0;
    int current_element = n;

    for (int i = n - 1; i >= 0; i--) {
        // Add all elements greater than a[i] that haven't been forced into a spot
        while (current_element > a[i]) {
            if (!used[current_element]) {
                available_count++;
            }
            current_element--;
        }

        // If this position does not introduce a new minimum, we must choose
        // one of the available larger numbers for P[i]
        if (i > 0 && a[i] == a[i - 1]) {
            ans = (ans * available_count) % MOD;
            available_count--; // Use one available element
        }
    }

    cout << ans << "\n";
}

int main() {
    ios_base::sync_with_stdio(false);
    cin.tie(NULL);
    int t;
    if (cin >> t) {
        while (t--) {
            solve();
        }
    }
    return 0;
}
