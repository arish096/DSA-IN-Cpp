class Solution {
public:
    int singleNonDuplicate(vector<int>& A) {
        int n = A.size();

        if (n == 1)
            return A[0];

        if (A[0] != A[1])
            return A[0];

        if (A[n - 1] != A[n - 2])
            return A[n - 1];

        int st = 1;
        int end = n - 2;

        while (st <= end) {
            int mid = st + (end - st) / 2;

            if (A[mid] != A[mid - 1] &&
                A[mid] != A[mid + 1]) {
                return A[mid];
            }

            // mid is even
            if (mid % 2 == 0) {

                if (A[mid] == A[mid + 1]) {
                    st = mid + 2;
                }
                else {
                    end = mid - 1;
                }
            }

            // mid is odd
            else {

                if (A[mid] == A[mid - 1]) {
                    st = mid + 1;
                }
                else {
                    end = mid - 1;
                }
            }
        }

        return -1;
    }
};
